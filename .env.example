# Configuración del servidor
PORT=3001
NODE_ENV=development
# En producción es obligatoria: si falta, el arranque falla en vez de caer a localhost.
FRONTEND_URL=http://localhost:3000

# Base de datos (PostgreSQL / Supabase)
# Única fuente de conexión. No hay credenciales por defecto en el código.
DATABASE_URL=postgresql://usuario:contrasena@db.tu-proyecto.supabase.co:5432/postgres

# Supabase Auth
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_JWT_SECRET=tu-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=tu-supabase-service-role-key
SUPABASE_ANON_KEY=tu-supabase-anon-key

# Swagger. En producción queda apagado salvo que se active a propósito.
SWAGGER_ENABLED=true

# Rate limiting (@nestjs/throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Tests de integración
# Escriben en la base real de DATABASE_URL. La bandera se pasa por comando,
# no desde este archivo: ALLOW_DB_INTEGRATION_TESTS=true pnpm test:integration
ALLOW_DB_INTEGRATION_TESTS=false
# UUID de dos usuarios que existan de verdad en la tabla `usuario`.
# evento.usuario_id tiene FK contra usuario -> auth.users, así que no se pueden inventar.
TEST_USER_A_ID=
TEST_USER_B_ID=
