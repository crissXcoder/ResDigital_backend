{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "git:policy": "node tooling/git-policy.mjs",
    "git:workflows": "node tooling/security-tools.mjs actionlint && node tooling/git-policy.mjs --verify-workflows",
    "git:tools": "node tooling/security-tools.mjs actionlint",
    "git:setup-hooks": "node tooling/install-hooks.mjs",
    "test:policy": "node --test tooling/tests/*.test.mjs",
    "migration:replay": "node tooling/migration-replay.mjs",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "typeorm": "tsx --env-file=.env node_modules/typeorm/cli.js --dataSource src/database/data-source.ts",
    "migration:run": "tsx --env-file=.env node_modules/typeorm/cli.js migration:run --dataSource src/database/data-source.ts",
    "migration:revert": "tsx --env-file=.env node_modules/typeorm/cli.js migration:revert --dataSource src/database/data-source.ts",
    "migration:show": "tsx --env-file=.env node_modules/typeorm/cli.js migration:show --dataSource src/database/data-source.ts",
    "seed:dev": "tsx --env-file=.env src/database/scripts/seed-dev.ts",
    "seed:sanitary": "tsx --env-file=.env src/database/scripts/seed-sanitary.ts",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@supabase/supabase-js": "^2.116.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
